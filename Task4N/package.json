{
  "name": "Task4N",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@cap-js/hana": "^2.7.0",
    "@cap-js/sqlite": "^2.2.0",
    "@sap-cloud-sdk/connectivity": "^4.5.1",
    "@sap-cloud-sdk/http-client": "^4.5.1",
    "@sap/cds": "^9.8.3",
    "@sap/hana-client": "^2.28.17",
    "@sap/xssec": "^4.13.0",
    "axios": "^1.14.0",
    "sqlite": "^5.1.1"
  },
  "devDependencies": {
    "@sap/cds-dk": "^9.8.1"
  },
  "scripts": {
    "start": "npx cds-serve"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite"
      },
      "auth": {
        "kind": "dummy"
      },
      "[production]": {
        "auth": {
          "kind": "dummy"
        },
        "db": {
          "kind": "hana"
        },
        "MAP_API": {
          "kind": "rest",
          "credentials": {
            "destination": "MAP_API"
          }
        }
      }
    }
  }
}
