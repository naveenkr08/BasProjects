COLUMN TABLE vehiclemanagement_Vehicles (
  vehicleID NVARCHAR(20) NOT NULL,
  modelName NVARCHAR(100),
  oldPrice DECIMAL(15, 2),
  newPrice DECIMAL(15, 2),
  statuss NVARCHAR(30),
  createdAt NVARCHAR(5000),
  createdBy NVARCHAR(5000),
  readAt NVARCHAR(5000),
  readBy NVARCHAR(5000),
  modifiedAt NVARCHAR(5000),
  modifiedBy NVARCHAR(5000),
  state_stateId NVARCHAR(10),
  dealer_dealerID NVARCHAR(36),
  PRIMARY KEY(vehicleID)
)