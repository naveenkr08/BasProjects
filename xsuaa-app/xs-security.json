{
  "xsappname": "zentra_xsuaa",
  "tenant-mode": "dedicated",
  "oauth2-configuration": {
    "redirect-uris": [
      "http://localhost:5000/**",
      "https://*.cfapps.us10.hana.ondemand.com/**",
      "https://*.applicationstudio.cloud.sap/**"
    ]
  },
  "scopes": [
    {
      "name": "$XSAPPNAME.ZentraAdmin",
      "description": "Full admin access"
    },
    {
      "name": "$XSAPPNAME.ZentraEditor",
      "description": "Manage orders"
    },
    {
      "name": "$XSAPPNAME.ZentraViewer",
      "description": "Read-only catalog access"
    }
  ],
  "role-templates": [
    {
      "name": "ZentraAdmin",
      "description": "Zentra administrator",
      "scope-references": [
        "$XSAPPNAME.ZentraAdmin"
      ]
    },
    {
      "name": "ZentraEditor",
      "description": "Zentra order editor",
      "scope-references": [
        "$XSAPPNAME.ZentraEditor"
      ]
    },
    {
      "name": "ZentraViewer",
      "description": "Zentra catalog viewer",
      "scope-references": [
        "$XSAPPNAME.ZentraViewer"
      ]
    }
  ],
  "attributes": []
}
