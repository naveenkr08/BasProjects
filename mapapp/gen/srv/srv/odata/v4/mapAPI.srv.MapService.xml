      </Function>
      <Function Name="getAddressFromCoordinates" IsBound="false" IsComposable="false">
        <Parameter Name="latitude" Type="Edm.Decimal" Scale="variable"/>
        <Parameter Name="longitude" Type="Edm.Decimal" Scale="variable"/>
        <ReturnType Type="mapAPI.srv.MapService.Locations"/>
      </Function>
      <Function Name="getCitiesByDistrict" IsBound="false" IsComposable="false">
        <Parameter Name="district" Type="Edm.String"/>
        <ReturnType Type="Collection(mapAPI.srv.MapService.City)" Nullable="true"/>
      </Function>
      <Function Name="getVillagesByDistrict" IsBound="false" IsComposable="false">
        <Parameter Name="district" Type="Edm.String"/>
        <ReturnType Type="Collection(mapAPI.srv.MapService.Village)" Nullable="true"/>
      </Function>
      <Annotations Target="mapAPI.srv.MapService.ApiLogs/logID">
