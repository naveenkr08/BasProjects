      </Annotations>
      <Annotations Target="mapAPI.srv.MapService.getLocationInDetail(Edm.String)/address">
        <Annotation Term="Core.OptionalParameter">
          <Record Type="Core.OptionalParameterType"/>
        </Annotation>
      </Annotations>
      <Annotations Target="mapAPI.srv.MapService.getAddressFromCoordinates(Edm.Decimal,Edm.Decimal)/latitude">
        <Annotation Term="Core.OptionalParameter">
          <Record Type="Core.OptionalParameterType"/>
        </Annotation>
      </Annotations>
      <Annotations Target="mapAPI.srv.MapService.getAddressFromCoordinates(Edm.Decimal,Edm.Decimal)/longitude">
