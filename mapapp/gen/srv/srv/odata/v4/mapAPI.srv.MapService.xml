        <FunctionImport Name="getVillagesByDistrict" Function="mapAPI.srv.MapService.getVillagesByDistrict"/>
      </EntityContainer>
      <EntityType Name="ApiLogs">
        <Key>
          <PropertyRef Name="logID"/>
        </Key>
        <Property Name="logID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="functionName" Type="Edm.String" MaxLength="100"/>
        <Property Name="calledAt" Type="Edm.DateTimeOffset"/>
      </EntityType>
      <ComplexType Name="Locations">
        <Property Name="latitude" Type="Edm.Decimal" Precision="9" Scale="6"/>
        <Property Name="longitude" Type="Edm.Decimal" Precision="9" Scale="6"/>
        <Property Name="address" Type="Edm.String"/>
        <Property Name="location" Type="Edm.String"/>
        <Property Name="district" Type="Edm.String"/>
        <Property Name="state" Type="Edm.String"/>
        <Property Name="pincode" Type="Edm.String"/>
        <Property Name="country" Type="Edm.String"/>
      </ComplexType>
      <ComplexType Name="LatAndLong">
        <Property Name="latitude" Type="Edm.String"/>
        <Property Name="longitude" Type="Edm.String"/>
      </ComplexType>
      <ComplexType Name="District">
        <Property Name="name" Type="Edm.String"/>
      </ComplexType>
      <ComplexType Name="City">
        <Property Name="name" Type="Edm.String"/>
        <Property Name="pincode" Type="Edm.String"/>
      </ComplexType>
      <ComplexType Name="Village">
        <Property Name="name" Type="Edm.String"/>
      </ComplexType>
      <Function Name="getDistricts" IsBound="false" IsComposable="false">
        <Parameter Name="state" Type="Edm.String"/>
        <ReturnType Type="Collection(mapAPI.srv.MapService.District)" Nullable="true"/>
      </Function>
      <Function Name="getlatitudeAndLongitude" IsBound="false" IsComposable="false">
        <Parameter Name="cityname" Type="Edm.String"/>
